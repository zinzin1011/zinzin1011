# 각 줄의 = 뒤에 값을 붙여넣으세요 (띄어쓰기·따옴표 없이). # 으로 시작하는 줄은 설명입니다.

# ===== 꼭 필요 =====
NOTION_TOKEN=
HF_TOKEN=
MEETING_AUTHOR=

# 노션 DB ID (DB 주소의 32자리)
NOTION_MEETINGS_DB=
NOTION_DECISIONS_DB=
NOTION_SCHEDULE_DB=

# ===== 선택 =====
# 녹음 저장 폴더. 비워 두면 ~/Recordings/meetings (구글 드라이브 동기화 폴더를 넣으면 자동 업로드)
RECORD_DIR=
# 녹음 장치 (./mb record devices 로 번호 확인, :0 = 기본 마이크)
RECORD_DEVICE=:0
# 받아쓰기 엔진: mlx(Apple Silicon Mac) / local / openai
STT_BACKEND=mlx

# ===== 유료 기능에만 필요 (주간 리포트·폴더 자동 감시 등) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===== setup 명령으로 새 DB 를 만든 경우에만 =====
NOTION_TASKS_DB=
NOTION_CRM_DB=
NOTION_REPORTS_DB=
