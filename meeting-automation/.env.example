# --- 필수 ---
ANTHROPIC_API_KEY=sk-ant-...
NOTION_TOKEN=ntn_...            # https://www.notion.so/my-integrations 에서 발급

# --- `python -m meeting_bot setup` 실행 후 출력되는 값을 붙여넣기 ---
NOTION_MEETINGS_DB=
NOTION_TASKS_DB=
NOTION_SCHEDULE_DB=
NOTION_CRM_DB=
NOTION_REPORTS_DB=

# --- STT ---
STT_BACKEND=local               # local(faster-whisper) | openai
WHISPER_MODEL=large-v3          # local: tiny/base/small/medium/large-v3
OPENAI_API_KEY=                 # STT_BACKEND=openai 일 때만

# --- 선택 ---
CLAUDE_MODEL=claude-opus-5-5
TIMEZONE=Asia/Seoul
