# --- 필수 ---
ANTHROPIC_API_KEY=sk-ant-...
NOTION_TOKEN=ntn_...            # https://www.notion.so/my-integrations 에서 발급

# --- 기존 팀 노션에 쓰는 경우 (project 모드): DB 주소의 32자리 ID ---
# NOTION_MEETINGS_DB=   회의록 DB
# NOTION_DECISIONS_DB=  의사결정 기록 DB
# NOTION_SCHEDULE_DB=   프로젝트 일정 DB

# --- `python -m meeting_bot setup` 실행 후 출력되는 값을 붙여넣기 ---
NOTION_MEETINGS_DB=
NOTION_TASKS_DB=
NOTION_SCHEDULE_DB=
NOTION_CRM_DB=
NOTION_REPORTS_DB=
NOTION_DECISIONS_DB=

# --- Mac 무료 구성 (Claude Code 로 "회의 시작/끝") ---
RECORD_DIR=~/Library/CloudStorage/GoogleDrive-내계정/내 드라이브/00_관리/녹음   # 드라이브 동기화 폴더
RECORD_DEVICE=:0                # 녹음 장치 (python -m meeting_bot record devices 로 확인)
MEETING_AUTHOR=                 # 회의록 '작성자' 기본값
HF_TOKEN=                       # 화자 구분용 Hugging Face 토큰 (무료)

# --- STT ---
STT_BACKEND=mlx                 # mlx(Apple Silicon Mac) | local(faster-whisper) | openai
WHISPER_MODEL=large-v3          # local: tiny/base/small/medium/large-v3
OPENAI_API_KEY=                 # STT_BACKEND=openai 일 때만

# --- 선택 ---
CLAUDE_MODEL=claude-opus-5-5
TIMEZONE=Asia/Seoul
